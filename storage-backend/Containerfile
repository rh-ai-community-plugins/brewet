# Stage 1: Build
FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder

USER 0
WORKDIR /opt/app-root/src

COPY package.json package-lock.json* ./
RUN npm ci

COPY tsconfig.json ./
COPY src/ ./src/

RUN npm run build

# Stage 2: Production runtime
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:latest

USER 0
WORKDIR /opt/app-root/src

COPY --from=builder /opt/app-root/src/package.json /opt/app-root/src/package-lock.json* ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /opt/app-root/src/dist/ ./dist/

# Create default local storage directory
RUN mkdir -p /opt/app-root/src/data && chown -R 1001:0 /opt/app-root/src

USER 1001

ENV PORT=8888 \
    HOST=0.0.0.0 \
    NODE_ENV=production \
    LOCAL_STORAGE_PATHS=/opt/app-root/src/data

EXPOSE 8888

CMD ["node", "dist/server.js"]
