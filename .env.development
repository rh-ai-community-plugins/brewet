DEPLOYMENT_MODE=federated
# [PLUGIN-SPECIFIC] must match route prefix in extensions.ts
URL_PREFIX=/brewet
BFF_API_VERSION=v1
MANDATORY_NAMESPACE=

# Storage backend image used when creating per-project containers.
# Override to use a local or custom image during development.
STORAGE_BACKEND_IMAGE=quay.io/rh-ai-community-plugins/brewet-storage-backend:0.1.0
